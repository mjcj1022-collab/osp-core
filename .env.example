# Copy to .env for local dev (or set these in Render).  DO NOT commit real values.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=*
# The ONE shared Postgres. Must have the postgis extension available.
DATABASE_URL=postgres://user:password@localhost:5432/osp
DB_SSL_REQUIRE=false
# Netlify Identity JWT secret (verifies logins). From the site's Identity settings.
GOTRUE_JWT_SECRET=your-netlify-identity-jwt-secret
# Front-ends allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=https://light-speed-bim.netlify.app,https://redline-app.netlify.app,https://courageous-seahorse-d21112.netlify.app,https://lucky-basbousa-c909b8.netlify.app
